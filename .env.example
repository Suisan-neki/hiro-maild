# Examples only. Real credentials belong in Render Environment, never Git.
# Web OAuth clients (NOT the Desktop client used by gmail-auth).
HIRO_MAILD_OWNER_GMAIL=you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
# Generate a random value >=32 characters once; retain it across deployments.
HIRO_MAILD_TOKEN_KEY=
# Render supplies RENDER_EXTERNAL_URL and PORT automatically.
# For local development only:
HIRO_MAILD_PUBLIC_URL=http://127.0.0.1:8080
HIRO_MAILD_DATA_DIR=/tmp/hiro-maild-web
HIRO_MAILD_CLOUD_INTERVAL_SECONDS=60

# Existing local CLI only; neither option is needed for the web service.
# HIRO_MAILD_THUNDERBIRD_STORE=/path/to/Thunderbird/Profiles/.../ImapMail/outlook.office365.com
# OPENAI_API_KEY=
# HIRO_MAILD_OPENAI_MODEL=gpt-5.6-luna
