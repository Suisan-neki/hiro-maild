<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.suisan.hiro-maild</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/.local/bin/hiro-maild</string>
    <string>--data-dir</string>
    <string>/Users/YOUR_USER/Library/Application Support/hiro-maild</string>
    <string>daemon</string>
    <string>--store</string>
    <string>/Users/YOUR_USER/Library/Thunderbird/Profiles/YOUR_PROFILE/ImapMail/outlook.office365.com</string>
    <string>--forward</string>
    <string>--forward-dry-run</string>
    <string>--interval-seconds</string>
    <string>300</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/Library/Logs/hiro-maild/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/Library/Logs/hiro-maild/stderr.log</string>
</dict>
</plist>
